server:
  port: 10000

spring:
  datasource:
    driver-class-name: oracle.jdbc.OracleDriver
    url: jdbc:oracle:thin:@localhost:1521:XE
    username: replace-with-oracle-user
    password: replace-with-oracle-password

  data:
    redis:
      host: localhost
      port: 6379
      timeout: 60000

  cache:
    type: redis

  security:
    oauth2:
      client:
        registration:
          google:
            client-id: "replace-with-google-client-id"
            client-secret: "replace-with-google-client-secret"
            scope:
              - email
              - profile
            redirect-uri: "http://localhost:10000/login/oauth2/code/google"
            authorization-grant-type: authorization_code
            client-name: Google
            provider: google
          naver:
            client-id: "replace-with-naver-client-id"
            client-secret: "replace-with-naver-client-secret"
            scope:
              - name
              - email
            redirect-uri: "http://localhost:10000/login/oauth2/code/naver"
            authorization-grant-type: authorization_code
            client-name: Naver
            provider: naver
          kakao:
            client-id: "replace-with-kakao-client-id"
            scope:
              - profile_nickname
              - account_email
            redirect-uri: "http://localhost:10000/login/oauth2/code/kakao"
            authorization-grant-type: authorization_code
            client-name: Kakao
            provider: kakao
        provider:
          google:
            authorization-uri: https://accounts.google.com/o/oauth2/v2/auth
            token-uri: https://oauth2.googleapis.com/token
            user-info-uri: https://www.googleapis.com/oauth2/v3/userinfo
            user-name-attribute: name
          naver:
            authorization-uri: https://nid.naver.com/oauth2.0/authorize
            token-uri: https://nid.naver.com/oauth2.0/token
            user-info-uri: https://openapi.naver.com/v1/nid/me
            user-name-attribute: response
          kakao:
            authorization-uri: https://kauth.kakao.com/oauth/authorize
            token-uri: https://kauth.kakao.com/oauth/token
            user-info-uri: https://kapi.kakao.com/v2/user/me
            user-name-attribute: id

  jpa:
    database-platform: org.hibernate.dialect.OracleDialect
    hibernate:
      ddl-auto: update

    properties:
      hibernate:
        format_sql: true
        show_sql: false

  output:
    ansi:
      enabled: never

logging:
  level:
    com.p6spy: DEBUG
    com.app.basic.config.p6spy: DEBUG

jwt:
  secret: "replace-with-local-jwt-secret"
  token-blacklist-prefix: "blacklist:"
  refresh-blacklist-prefix: "refresh:"
  access-token-validity-in-ms: "2592000000"
  refresh-token-validity-in-ms: "1209600000"

app:
  frontend:
    redirect-url: "http://localhost:3000"

api:
  emergency:
    service-key: "replace-with-emergency-service-key"
    check-emergency-url: "http://apis.data.go.kr/B552657/ErmctInfoInqireService/getEmrrmRltmUsefulSckbdInfoInqire"
    check-availability-url: "https://apis.data.go.kr/B552657/ErmctInfoInqireService/getSrsillDissAceptncPosblInfoInqire"
    search-emergency-list-url: "https://apis.data.go.kr/B552657/ErmctInfoInqireService/getEgytListInfoInqire"
    search-emergency-location-url: "https://apis.data.go.kr/B552657/ErmctInfoInqireService/getEgytLcinfoInqire"
    search-emergency-basic-url: "http://apis.data.go.kr/B552657/ErmctInfoInqireService/getEgytBassInfoInqire"
    search-trauma-list-url: "https://apis.data.go.kr/B552657/ErmctInfoInqireService/getStrmListInfoInqire"
    trauma-location-url: "https://apis.data.go.kr/B552657/ErmctInfoInqireService/getStrmLcinfoInqire"
    search-trauma-basic-url: "https://apis.data.go.kr/B552657/ErmctInfoInqireService/getEgytBassInfoInqire"
    emergency-trauma-message-url: "https://apis.data.go.kr/B552657/ErmctInfoInqireService/getEmrrmSrsillDissMsgInqire"

coolsms:
  api-key: "replace-with-coolsms-api-key"
  api-secret: "replace-with-coolsms-api-secret"
  sender: "010-1234-5678"

openai:
  api-key: "replace-with-openai-api-key"
